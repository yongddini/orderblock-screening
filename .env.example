# Obscreen 환경변수 예시 — 복사해 .env로 쓴다(.env는 커밋 금지).
# 비밀 값(API 키·토큰)이 생기면 여기에 이름만 예시로 추가한다.

# SQLite DB 파일 경로 (기본: 실행 폴더의 orderblock_screening.db)
DB_PATH=orderblock_screening.db

# 스크리닝 대상 종목 수 (시가총액 상위 N) · ETF 수
SCREENING_TOP_N=400
SCREENING_ETF_N=300

# development면 `obscreen serve`(= `python app_production.py`) 시작 때 스크리닝을 한 번 돌린다
FLASK_ENV=production

# ── OBS-4: obscreen/config.py (pydantic-settings) — 기본값은 옮기기 전 코드와 같다 ──
# 로그 폴더 (daily_screening.sh · deploy.sh · 기본: <저장소>/logs)
# OBS-6: systemd 유닛이 이 파일을 EnvironmentFile 로 읽으므로 셸 스크립트에도 전달된다.
#   (옛 crontab 방식에서는 .env 가 셸에 전달되지 않았다 — cron 줄에 직접 줘야 했다.)
#   ⚠️ systemd 형식: `이름=값` 한 줄, export·변수 치환 없음. 공백·#·따옴표가 든 값은 '작은따옴표'로.
# OBSCREEN_LOG_DIR=logs
# 수집이 쓸 파이썬 (daily_screening.sh · systemd 수집 유닛 기본: <저장소>/.venv/bin/python,
#   유닛 밖에서 직접 돌리면 <저장소>/venv310/bin/python3 가 있으면 그것, 없으면 python3)
# OBSCREEN_PYTHON=python3
# `obscreen serve` 개발 서버 주소·포트 (운영은 gunicorn이 정한다)
# OBSCREEN_HOST=0.0.0.0
# OBSCREEN_PORT=5000
# 근접도(%) — 일봉 주식 · 일봉 ETF · 주봉
# OBSCREEN_PROXIMITY_STOCK_DAILY=3.0
# OBSCREEN_PROXIMITY_ETF_DAILY=1.0
# OBSCREEN_PROXIMITY_WEEKLY=5.0
# 탐지기 — 기본값은 AlphaBlock OrderBlockParams() 그대로(OBS-5). 국장 조정은 별도 이슈.
# OBSCREEN_SWING_LENGTH=10
# OBSCREEN_MAX_ATR_MULT=3.5
# OBSCREEN_OB_END_METHOD=Wick
# OBSCREEN_COMBINE_OBS=false

# ── 배포 스크립트(OBS-6 · scripts/deploy.sh · health-check.sh) — 셸 환경변수로 준다 ──
# OBSCREEN_SERVICE=orderblock                       # 웹 systemd 서비스 이름
# OBSCREEN_HEALTH_URL=https://<도메인>/health       # /health 를 이 URL로 확인(기본: 유닛 바인드)

# ── KRX 로그인(pykrx 1.2.x 수급 조회) · DART ──
# pykrx가 os 환경변수에서 직접 읽는다. OBS-6 이후 systemd 유닛(웹·수집)이 이 .env 를
# EnvironmentFile 로 읽어 프로세스 환경변수로 넘기므로 **여기에 둔다**(crontab 평문 제거 — 런북 §3).
# 이 파일은 chmod 600. 값은 `systemctl show` 에 나오지 않는다.
# KRX_ID=...
# KRX_PW=...
# DART_API_KEY=...
